<h1>KelloggCoin Ledger</h1>

<!-- Step 1: List all transactions, starting with the ICO -->
<h2>Transactions</h2>
<ol>
  <% Transaction.order(:id).each do |transaction| %>
    <% from_user = User.find_by({ :id => transaction.from_user_id }) %>
    <% to_user = User.find_by({ :id => transaction.to_user_id }) %>
    <li>
      <% if from_user %>
        <%= transaction.amount %> KC from <%= from_user.name %> to <%= to_user.name %>
      <% else %>
        Initial coin offering: <%= transaction.amount %> to <%= to_user.name %>
      <% end %>
    </li>
  <% end %>
</ol>

<!-- Step 2: Calculate and display the balances -->
<h2>Balances</h2>
<%
  balances = User.all.map do |user|
    received = Transaction.where({ "to_user_id" => user.id }).sum("amount")
    sent = Transaction.where({ "from_user_id" => user.id }).sum("amount")
    { :name => user.name, :balance => received - sent }
  end
  balances = balances.sort_by { |row| -row[:balance] }
  total = balances.sum { |row| row[:balance] }
%>
<table class="balances">
  <tr>
    <th>User</th>
    <th class="amount">Balance</th>
  </tr>
  <% balances.each_with_index do |row, index| %>
    <tr class="<%= "top" if index == 0 %>">
      <td><%= "👑 " if index == 0 %><%= row[:name] %></td>
      <td class="amount"><%= number_with_delimiter(row[:balance]) %> KC</td>
    </tr>
  <% end %>
  <tr class="total">
    <td>Total</td>
    <td class="amount"><%= number_with_delimiter(total) %> KC</td>
  </tr>
</table>

